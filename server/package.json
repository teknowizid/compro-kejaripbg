{
  "name": "kejari-server",
  "version": "1.1.0",
  "description": "Backend API CMS Website Kejaksaan Negeri Purbalingga (SQLite & MySQL)",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:status": "knex migrate:list --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "migrate:mysql": "node scripts/migrate-to-mysql.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^4.21.2",
    "knex": "^3.3.0",
    "mysql2": "^3.24.5"
  }
}