# ==============================================================================
# Konfigurasi Basis Data Kejari Purbalingga CMS (SQLite & MySQL)
# ==============================================================================

# Pilihan driver: "sqlite" (default local) atau "mysql" (production/cloud)
DB_CLIENT=sqlite

# Konfigurasi SQLite (digunakan jika DB_CLIENT=sqlite)
DB_PATH=./data/kejari.db

# Konfigurasi MySQL (digunakan jika DB_CLIENT=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kejari_db

# Connection Pool (khusus MySQL)
DB_POOL_MIN=2
DB_POOL_MAX=10

# Port Server Backend
PORT=3001
